# DEADBOLT Environment Template (Zero secrets committed)
PORT=4090
SERVICE_NAME=deadbolt
DB_PATH=./data/deadbolt.db
STACK_DB_PATH=./data/krusch-stack.db
LOG_DIR=./logs

# Tier 1 & Tier 2A Sovereign Memory & AST Graph
KRUSCH_GIT_URL=http://127.0.0.1:4890
OLLAMA_URL=http://127.0.0.1:11434

# 8090 Software Factory v2 APIs & MCP (https://docs.8090.ai/api-reference)
# - SOFA_ADMIN_API_KEY (sofa-admin-*): Organization Admin API (/v2/organization-api/spend-status)
# - SOFA_API_KEY (sofa-ext-*): Project External API (/v2/external-api/health & /work_orders)
# - SOFA_REPORTING_API_KEY (sf-rpt-*): Feedback Integration API (/v2/reporting-api/feedback)
SOFA_API_BASE_URL=https://api.factory.8090.dev
SOFA_MCP_URL=https://api.factory.8090.dev/v2/mcp
SOFA_PROJECT_ID=
SOFA_API_KEY=
SOFA_ADMIN_API_KEY=
SOFA_REPORTING_API_KEY=

# Sponsor Integrations (Optional; clean local deterministic fallbacks active when unset)
HYDRADB_API_KEY=
HYDRADB_BASE_URL=https://api.hydradb.com
HYDRADB_DATABASE=default-tenant
HYDRADB_COLLECTION=work_orders
HYDRADB_GRAPH_URL=
HYDRADB_GRAPH_TOKEN=
HYDRADB_GRAPH_ID=deadbolt-factory
HYDRADB_CELL_ID=cell-0
HYDRADB_NAMESPACE=default
HYDRADB_ALLOW_LAN=false

# Composio Connect Consumer Key (ck_*) -> COMPOSIO_MCP_URL, or Developer Key (ak_*) -> COMPOSIO_BASE_URL
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional Cross-Family Model Reviewers & Vercel AI Gateway
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
AUDIT_HMAC_SECRET=deadbolt-local-dev-hmac-change-in-prod
